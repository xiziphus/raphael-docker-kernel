#!/system/bin/sh
##########################################################################
# dockerctl - one entry point for Docker on Android.
#
#   dockerctl setup [rootfs.tar.xz]   one-time: Debian + Docker
#   dockerctl start | stop | restart  the daemon (applies net rules too)
#   dockerctl status                  short summary
#   dockerctl doctor [--fix]          check every prerequisite; repair
#   dockerctl net apply|check|clear   Android routing/firewall rules
#   dockerctl ui start|stop|status    Portainer
#   dockerctl ui admin <password>     create the Portainer admin, no browser
#   dockerctl tunnel quick [url]       ephemeral public URL via Cloudflare
#   dockerctl tunnel token <token>     named tunnel from the CF dashboard
#   dockerctl shell                   a shell in the Debian chroot
#   dockerctl <anything else>         passed to docker in the chroot
##########################################################################
set -u
D=/data/adb/docker
. "$D/lib.sh"; . "$D/mount.sh"; . "$D/net.sh"; . "$D/daemon.sh"
. "$D/ui.sh"; . "$D/setup.sh"; . "$D/doctor.sh"; . "$D/tunnel.sh"; . "$D/wake.sh"

[ "$(id -u)" = 0 ] || { bad "must run as root: su -c 'dockerctl $*'"; exit 1; }

cmd="${1:-status}"; [ $# -gt 0 ] && shift

case "$cmd" in
  setup)   do_setup "${1:-}" ;;
  start)   daemon_start ;;
  stop)    daemon_stop ;;
  restart) daemon_stop; daemon_start ;;
  doctor)  do_doctor "${1:-}" ;;
  shell)   in_chroot "$@" ;;
  net)
    case "${1:-check}" in
      apply) net_apply && ok "rules applied for $POOL" ;;
      check) net_check ;;
      clear) net_clear; ok "rules removed" ;;
      *)     bad "usage: dockerctl net apply|check|clear"; exit 1 ;;
    esac ;;
  ui)
    case "${1:-status}" in
      start)  ui_start ;;
      stop)   ui_stop ;;
      status) ui_status ;;
      admin)  shift; ui_admin "${1:-}" ;;
      open)   am start -a android.intent.action.VIEW -d http://127.0.0.1:9000 >/dev/null 2>&1
              ok "opened in browser" ;;
      *)      bad "usage: dockerctl ui start|stop|status|admin <pw>|open"; exit 1 ;;
    esac ;;
  autostart)
    case "${1:-status}" in
      on)     touch "$STATE/autostart";  ok "autostart ON" ;;
      off)    rm -f "$STATE/autostart";  ok "autostart OFF" ;;
      status) [ -f "$STATE/autostart" ] && ok "autostart ON" || bad "autostart OFF" ;;
      *)      bad "usage: dockerctl autostart on|off|status"; exit 1 ;;
    esac ;;
  wake)
    # Android suspends ~2.5x/second with no wakelock held, freezing containers
    # mid-work. `auto` is the sane default: stay awake only while something you
    # named is actually running.
    case "${1:-status}" in
      off|auto|always) wake_set "$1" && ok "wakelock mode: $1" ;;
      add)    shift; wake_add "${1:-}"  && { wake_sync; ok "watching ${1:-}"; } ;;
      rm)     shift; wake_rm  "${1:-}"  && { wake_sync; ok "no longer watching ${1:-}"; } ;;
      sync)   wake_sync; wake_status ;;
      status) wake_status ;;
      *)      bad "usage: dockerctl wake off|auto|always|add <ct>|rm <ct>|status"; exit 1 ;;
    esac ;;
  json)
    # Machine-readable state for the WebUI: one key=value per line, so the page
    # parses a single call instead of shelling out six times.
    printf 'kernel=%s\n'    "$( { [ -e /proc/self/ns/user ] && grep -qE '^pids[[:space:]]' /proc/cgroups; } >/dev/null 2>&1 && echo ok || echo no)"
    printf 'rootfs=%s\n'    "$(have_rootfs && echo ok || echo no)"
    printf 'daemon=%s\n'    "$(running && echo ok || echo no)"
    printf 'net=%s\n'       "$(net_check >/dev/null 2>&1 && echo ok || echo no)"
    printf 'autostart=%s\n' "$([ -f "$STATE/autostart" ] && echo on || echo off)"
    printf 'sshd=%s\n' "$([ -f "$STATE/sshd" ] && echo on || echo off)"
    # Enabled-at-boot and actually-listening are different things, and the UI
    # showed a green toggle for an sshd that was never installed. Report both.
    printf 'sshdrun=%s\n' "$(in_chroot 'pgrep -x sshd >/dev/null' >/dev/null 2>&1 && echo yes || echo no)"
    printf 'wake=%s\n'      "$(wake_mode)"
    printf 'wakeheld=%s\n'  "$(wake_held && echo yes || echo no)"
    printf 'wakeok=%s\n'    "$(wake_supported && echo yes || echo no)"
    # Space-separated so the page can test membership without a second call.
    printf 'wakelist=%s\n'  "$(wake_list | tr '\n' ' ')"
    printf 'uplinks=%s\n'   "$(uplinks | tr '\n' ' ')"
    printf 'vpn=%s\n'       "$(vpn_holds_root && echo yes || echo no)"
    if running; then
        in_chroot_exec docker ps -a --format 'container={{.Names}}|{{.Status}}|{{.Image}}' 2>/dev/null
    fi ;;
  tunnel)
    case "${1:-status}" in
      token)  shift; tunnel_token "${1:-}" ;;
      quick)  shift; tunnel_quick "${1:-}" ;;
      named)  tunnel_named ;;
      stop)   tunnel_stop ;;
      status) tunnel_status ;;
      *)      bad "usage: dockerctl tunnel token <tok> | quick [url] | named | stop | status"; exit 1 ;;
    esac ;;
  ssh)
    # sshd runs INSIDE the chroot bound to loopback, reachable only through the
    # Cloudflare tunnel. Enabling it here also makes the boot service start it,
    # so remote access survives a reboot -- otherwise an unattended restart
    # leaves the device unreachable until someone plugs in USB.
    case "${1:-status}" in
      on)
           # setup.sh installs only docker.io and iptables, so on a fresh rootfs
           # /usr/sbin/sshd does not exist. The previous version touched the
           # state file and printed ok unconditionally, so the toggle went green
           # and json reported sshd=on while nothing was listening.
           if ! in_chroot 'test -x /usr/sbin/sshd' >/dev/null 2>&1; then
               say "  installing openssh-server (needs network, may take a minute)"
               in_chroot 'export DEBIAN_FRONTEND=noninteractive
                          apt-get update >/dev/null 2>&1
                          apt-get install -y openssh-server >/dev/null 2>&1' || true
           fi
           if ! in_chroot 'test -x /usr/sbin/sshd' >/dev/null 2>&1; then
               bad "openssh-server not installed - check network and retry"
               exit 1
           fi
           # Debian's stock config listens on 0.0.0.0 with password auth. The
           # chroot shares Android's netstack (no netns of its own), so that
           # would put a root shell on the LAN. Pin it to loopback and keys.
           #
           # Only if nothing already sets Port: sshd treats repeated Port as
           # ADDITIVE, so writing ours alongside an existing drop-in asks it to
           # bind the same port twice and it fails to start. Respect whatever
           # the user configured rather than fighting it.
           in_chroot 'mkdir -p /etc/ssh/sshd_config.d /run/sshd
             if ! grep -rqsE "^[[:space:]]*Port[[:space:]]+[0-9]" \
                    /etc/ssh/sshd_config /etc/ssh/sshd_config.d/ 2>/dev/null; then
                 cat > /etc/ssh/sshd_config.d/99-android.conf <<CONF
ListenAddress 127.0.0.1
Port 2222
PermitRootLogin prohibit-password
PasswordAuthentication no
KbdInteractiveAuthentication no
CONF
             fi
             # Never restart into a broken config - a bad drop-in would leave
             # the device unreachable with no way back in but USB.
             /usr/sbin/sshd -t 2>&1 || { echo "sshd config invalid, not starting"; exit 1; }
             pgrep -x sshd >/dev/null || /usr/sbin/sshd'
           if in_chroot 'pgrep -x sshd >/dev/null' >/dev/null 2>&1; then
               touch "$STATE/sshd"
               ok "sshd listening on 127.0.0.1:2222 (key auth only)"
               in_chroot 'test -s /root/.ssh/authorized_keys' >/dev/null 2>&1 \
                 || warn "no authorized_keys yet - nothing can log in until you add one"
           else
               bad "sshd failed to start"; exit 1
           fi ;;
      off) rm -f "$STATE/sshd"; in_chroot 'pkill -x sshd' >/dev/null 2>&1; ok "sshd disabled" ;;
      status)
           [ -f "$STATE/sshd" ] && ok "sshd enabled at boot" || bad "sshd not enabled at boot"
           in_chroot 'pgrep -x sshd >/dev/null && echo "  running" || echo "  not running"
                      test -s /root/.ssh/authorized_keys \
                        && echo "  authorized_keys: $(grep -c . /root/.ssh/authorized_keys) key(s)" \
                        || echo "  authorized_keys: EMPTY - no login possible"' ;;
      *)   bad "usage: dockerctl ssh on|off|status"; exit 1 ;;
    esac ;;
  status)
    have_rootfs && ok "rootfs $ROOT" || bad "no rootfs (dockerctl setup)"
    running     && ok "dockerd running" || bad "dockerd stopped"
    net_check >/dev/null 2>&1 && ok "network rules applied" || bad "network rules missing"
    running && in_chroot 'docker ps --format "  {{.Names}}  {{.Status}}"' 2>/dev/null ;;
  # Anything unrecognised goes straight to the docker CLI, so
  # "dockerctl ps", "dockerctl logs x", "dockerctl compose ..." all work.
  *) in_chroot_exec docker "$cmd" "$@" ;;
esac
