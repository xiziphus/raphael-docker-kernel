#!/system/bin/sh
##########################################################################
# dockerctl - one entry point for Docker on Android.
#
#   dockerctl setup [rootfs.tar.xz]   one-time: Debian + Docker
#   dockerctl start | stop | restart  the daemon (applies net rules too)
#   dockerctl status                  short summary
#   dockerctl doctor [--fix]          check every prerequisite; repair
#   dockerctl net apply|check|clear   Android routing/firewall rules
#   dockerctl ui start|stop|status    Portainer
#   dockerctl ui admin <password>     create the Portainer admin, no browser
#   dockerctl tunnel quick [url]       ephemeral public URL via Cloudflare
#   dockerctl tunnel token <token>     named tunnel from the CF dashboard
#   dockerctl shell                   a shell in the Debian chroot
#   dockerctl <anything else>         passed to docker in the chroot
##########################################################################
set -u
D=/data/adb/docker
. "$D/lib.sh"; . "$D/mount.sh"; . "$D/net.sh"; . "$D/daemon.sh"
. "$D/ui.sh"; . "$D/setup.sh"; . "$D/doctor.sh"; . "$D/tunnel.sh"; . "$D/wake.sh"; . "$D/lan.sh"; . "$D/sshd.sh"

[ "$(id -u)" = 0 ] || { bad "must run as root: su -c 'dockerctl $*'"; exit 1; }

cmd="${1:-status}"; [ $# -gt 0 ] && shift

case "$cmd" in
  setup)   do_setup "${1:-}" ;;
  start)   daemon_start ;;
  stop)    daemon_stop ;;
  restart) daemon_stop; daemon_start ;;
  doctor)  do_doctor "${1:-}" ;;
  shell)   in_chroot "$@" ;;
  net)
    case "${1:-check}" in
      apply) net_apply && ok "rules applied for $POOL" ;;
      check) net_check ;;
      clear) net_clear; ok "rules removed" ;;
      *)     bad "usage: dockerctl net apply|check|clear"; exit 1 ;;
    esac ;;
  ui)
    case "${1:-status}" in
      start)  ui_start ;;
      stop)   ui_stop ;;
      status) ui_status ;;
      admin)  shift; ui_admin "${1:-}" ;;
      open)   am start -a android.intent.action.VIEW -d http://127.0.0.1:9000 >/dev/null 2>&1
              ok "opened in browser" ;;
      *)      bad "usage: dockerctl ui start|stop|status|admin <pw>|open"; exit 1 ;;
    esac ;;
  autostart)
    case "${1:-status}" in
      on)     touch "$STATE/autostart";  ok "autostart ON" ;;
      off)    rm -f "$STATE/autostart";  ok "autostart OFF" ;;
      status) [ -f "$STATE/autostart" ] && ok "autostart ON" || bad "autostart OFF" ;;
      *)      bad "usage: dockerctl autostart on|off|status"; exit 1 ;;
    esac ;;
  lan)
    # DHCP moves this device; over one session it was .67, .72 then .85. Publish
    # the current address to the notification shade so it is readable even when
    # nothing can connect.
    case "${1:-status}" in
      now|publish) lan_publish 1 >/dev/null && ok "published $(lan_ip)" ;;
      on)     touch "$LAN_STATE_F"; lan_publish 1 >/dev/null; ok "auto-publish ON" ;;
      off)    rm -f "$LAN_STATE_F"; ok "auto-publish OFF" ;;
      ip)     lan_ip ;;
      status) lan_status ;;
      *)      bad "usage: dockerctl lan now|on|off|ip|status"; exit 1 ;;
    esac ;;
  wake)
    # Android suspends ~2.5x/second with no wakelock held, freezing containers
    # mid-work. `auto` is the sane default: stay awake only while something you
    # named is actually running.
    case "${1:-status}" in
      off|auto|always) wake_set "$1" && ok "wakelock mode: $1" ;;
      add)    shift; wake_add "${1:-}"  && { wake_sync; ok "watching ${1:-}"; } ;;
      rm)     shift; wake_rm  "${1:-}"  && { wake_sync; ok "no longer watching ${1:-}"; } ;;
      sync)   wake_sync; wake_status ;;
      floor)  shift
              case "${1:-status}" in
                on)  rm -f "$WAKE_NOFLOOR_F"; wake_floor_sync; ok "lifeline floor ON" ;;
                off) touch "$WAKE_NOFLOOR_F"; wake_floor_sync
                     warn "lifeline floor OFF - remote access may be suspended away" ;;
                *)   wake_floor_held && ok "lifeline held" || bad "lifeline not held" ;;
              esac ;;
      status) wake_status ;;
      *)      bad "usage: dockerctl wake off|auto|always|add <ct>|rm <ct>|floor on|off|status"; exit 1 ;;
    esac ;;
  json)
    # Machine-readable state for the WebUI: one key=value per line, so the page
    # parses a single call instead of shelling out six times.
    printf 'kernel=%s\n'    "$( { [ -e /proc/self/ns/user ] && grep -qE '^pids[[:space:]]' /proc/cgroups; } >/dev/null 2>&1 && echo ok || echo no)"
    printf 'rootfs=%s\n'    "$(have_rootfs && echo ok || echo no)"
    printf 'daemon=%s\n'    "$(running && echo ok || echo no)"
    printf 'net=%s\n'       "$(net_check >/dev/null 2>&1 && echo ok || echo no)"
    printf 'autostart=%s\n' "$([ -f "$STATE/autostart" ] && echo on || echo off)"
    printf 'sshd=%s\n' "$([ -f "$STATE/sshd" ] && echo on || echo off)"
    # Enabled-at-boot and actually-listening are different things, and the UI
    # showed a green toggle for an sshd that was never installed. Report both.
    printf 'sshdrun=%s\n'  "$(sshd_running && echo yes || echo no)"
    printf 'sshlan=%s\n'   "$(sshd_lan && echo on || echo off)"
    printf 'sshport=%s\n'  "$(sshd_port)"
    printf 'wake=%s\n'      "$(wake_mode)"
    printf 'wakeheld=%s\n'  "$(wake_held && echo yes || echo no)"
    printf 'wakeok=%s\n'    "$(wake_supported && echo yes || echo no)"
    printf 'wakefloor=%s\n' "$(wake_floor_held && echo yes || echo no)"
    printf 'floorwant=%s\n' "$([ -f "$WAKE_NOFLOOR_F" ] && echo off || echo on)"
    # Space-separated so the page can test membership without a second call.
    printf 'wakelist=%s\n'  "$(wake_list | tr '\n' ' ')"
    printf 'lanip=%s\n'     "$(lan_ip)"
    printf 'lanwatch=%s\n' "$(lan_enabled && echo on || echo off)"
    printf 'uplinks=%s\n'   "$(uplinks | tr '\n' ' ')"
    printf 'tunnel=%s\n'    "$(tunnel_mode)"
    printf 'tunnelup=%s\n'  "$(tunnel_running && echo yes || echo no)"
    printf 'vpn=%s\n'       "$(vpn_holds_root && echo yes || echo no)"
    if running; then
        in_chroot_exec docker ps -a --format 'container={{.Names}}|{{.Status}}|{{.Image}}' 2>/dev/null
    fi ;;
  tunnel)
    case "${1:-status}" in
      token)  shift; tunnel_token "${1:-}" ;;
      quick)  shift; tunnel_quick "${1:-}" ;;
      named)  tunnel_named ;;
      stop)   tunnel_stop ;;
      status) tunnel_status ;;
      log)    shift; tunnel_log "${1:-40}" ;;
      *)      bad "usage: dockerctl tunnel token <tok> | quick [url] | named | stop | status | log [n]"; exit 1 ;;
    esac ;;
  ssh)
    # sshd lives in the chroot, not a container, so it survives dockerd being
    # down -- which is precisely when a shell is needed. See common/sshd.sh.
    case "${1:-status}" in
      on)     sshd_enable ;;
      off)    sshd_disable ;;
      lan)    shift; sshd_set_lan "${1:-}" || { bad "usage: dockerctl ssh lan on|off"; exit 1; } ;;
      status) sshd_status ;;
      *)      bad "usage: dockerctl ssh on|off|lan on|off|status"; exit 1 ;;
    esac ;;
  status)
    have_rootfs && ok "rootfs $ROOT" || bad "no rootfs (dockerctl setup)"
    running     && ok "dockerd running" || bad "dockerd stopped"
    net_check >/dev/null 2>&1 && ok "network rules applied" || bad "network rules missing"
    running && in_chroot 'docker ps --format "  {{.Names}}  {{.Status}}"' 2>/dev/null ;;
  # Anything unrecognised goes straight to the docker CLI, so
  # "dockerctl ps", "dockerctl logs x", "dockerctl compose ..." all work.
  *) in_chroot_exec docker "$cmd" "$@" ;;
esac
